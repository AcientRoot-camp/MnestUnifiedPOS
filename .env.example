# MNest UnifiedPOS · environment settings
# -----------------------------------------------------------------------------------------------------------------
# Fill in the values for the services you use. Everything is optional: when a value is empty the feature falls back
# gracefully (for example, the shop assistant answers from the store's own data, background removal runs in the
# browser, and the tills keep working offline).
#
# Server keys (no VITE_ prefix) are read only by the serverless functions in /api and never reach the browser.
# Set the same names in your host's environment variables (Vercel → Project → Settings → Environment Variables).
# Values starting with VITE_ are built into the browser app, so never put a secret in a VITE_ variable.
#
# Template: copy this file to .env and fill in your own values. Safe to share (it holds no keys).
# -----------------------------------------------------------------------------------------------------------------

# --- Shop assistant AI answers (api/chat.js) ------------------------------------------------------------------
# From https://platform.claude.com · used only for questions the store's own data cannot answer. Billed per message.
ANTHROPIC_API_KEY=

# --- Order Confirmation emails (api/send-email.js) ------------------------------------------------------------
# From https://resend.com. EMAIL_FROM must use a domain verified in Resend, e.g. Ebenezer Unique Ventures <orders@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# --- Logo background removal (api/remove-bg.js) ---------------------------------------------------------------
# From https://www.remove.bg/api. Without it, backgrounds are removed in the browser.
REMOVE_BG_API_KEY=

# --- Shared database for barcodes, shop codes and time-clock sign-ins (api/_kv.js) -----------------------------
# Upstash Redis / Vercel KV REST credentials. Use either the KV_* pair or the UPSTASH_* pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: keeps this company's data apart from others on a shared database (letters, numbers, - and _ only).
COMPANY_ID=

# --- 09:00 "nobody signed in" check (api/cron/no-sign-in.js, scheduled in vercel.json) --------------------------
# A long random string; Vercel Cron sends it so nobody else can trigger the check.
CRON_SECRET=
# JSON: each branch id → its manager's name and email, e.g.
# {"osu":{"name":"Osu","email":"ama@yourdomain.com"},"legon":{"name":"East Legon","email":"efua@yourdomain.com"},"adum":{"name":"Adum","email":"yaw@yourdomain.com"}}
BRANCH_MANAGERS=
# The Admin's email, copied on every alert.
ADMIN_EMAIL=

# --- Browser app overrides (optional) --------------------------------------------------------------------------
# Leave empty to use the built-in /api endpoints. Set only if those endpoints live on another domain.
VITE_EMAIL_API=
VITE_BG_API=
